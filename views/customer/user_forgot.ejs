<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- <link rel="stylesheet" href="/css/user_css/user_forgot.css"> -->
    <title>
        <%= forgotpassword %>
    </title>

</head>

<body>
    <div class="container">
        <h2>Forgot Password?</h2>
        <p class="description">
            Enter your email address and we'll send you
            a link to reset your password.
        </p>
        <form>
            <div class="input-group">
                <label>Email</label>
                <input type="email" placeholder="Enter your email" required>
            </div>
            <button type="submit">
                Send Reset Link
            </button>
        </form>
        <div class="back">
            <a href="/user/login">← Back to Login</a>
        </div>
    </div>
</body>

</html>