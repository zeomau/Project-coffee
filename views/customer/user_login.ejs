<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/user_css/user_login.css">

    <title>
        <%= customer %> | & Register
    </title>
</head>

<body>
    <div class="auth-wrapper">
        <aside class="brand-panel">
            <div class="circle"></div>
            <div class="brand-content">
                <div class="logo">
                    <div class="logo-icon">✦</div>
                    <span>
                        <%= customer %>
                    </span>
                </div>
                <h1> Coffee Time <span>keep safe!</span> </h1>
                <p> Your gonna love our coffee and matcha, made for your everyday moments. </p>
            </div>
            <div class="features">
                <div class="feature">
                    <span class="feature-icon"> ✓ </span>
                    <span> Simple and secure authentication </span>
                </div>
                <div class="feature">
                    <span class="feature-icon"> ✓ </span>
                    <span> Manage your account easily </span>
                </div>
                <div class="feature">
                    <span class="feature-icon"> ✓ </span>
                    <span> View your order history </span>
                </div>
            </div>
        </aside>
        <main class="form-panel">
            <div class="forms" id="forms">


                <!-- login form -->
                <section class="form-box login-form">
                    <div class="form-header">
                        <h2>Welcome back</h2>
                        <p>Sign in to continue to your account.</p>
                    </div>
                    <section class="login-form">
                        <form action="/user/login" method="POST">

                            <label for="email">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="Enter your email" required>

                            <label for="password">Password</label>
                            <input type="password" id="password" name="password" placeholder="Enter your password"
                                required>
                            <div class="login-options">
                                <label><input type="checkbox" name="remember"> Remember me </label>
                                <a href="/user/forgot">Forgot password?</a>
                            </div>
                            <button type="submit">Sign In</button>
                        </form>
                    </section>
                    <div class="divider">
                        <span> OR </span>
                    </div>
                    <p class="switch-text">
                        Don't have an account?
                        <a href="#" class="link" onclick="showRegister(event)">Create an account</a>
                    </p>
                </section>



                <!-- register form -->
                <section class="register-form">

                    <h2>Create Account</h2>
                    <p>Create your account to get started.</p>

                    <form action="/user/register" method="POST">

                        <label for="fullName">Full Name</label>
                        <input type="text" id="fullName" name="name" placeholder="Enter your full name" required>

                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email" required>

                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Create a password"
                            minlength="8" required>

                        <label for="confirmPassword">Confirm Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword"
                            placeholder="Confirm your password" minlength="8" required>

                        <button type="submit">Create Account</button>
                    </form>
                    <p class="switch-text">
                        Already have an account?
                        <a href="#" class="link" onclick="showLogin(event)">Sign In</a>
                    </p>
                </section>
            </div>
        </main>
    </div>
</body>
<script>
    function showRegister(event) {
        event.preventDefault();

        document.getElementById("forms").style.transform =
            "translateX(-50%)";
    }

    function showLogin(event) {
        event.preventDefault();

        document.getElementById("forms").style.transform =
            "translateX(0)";
    }
</script>

</html>