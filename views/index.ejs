<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./css/index.css">
    <title>
        <%= website %>
    </title>
</head>
<body>
    <nav>
        <div class="logo">
            Coffee Time <span> keep safe!</span>
        </div>
        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#menu">Menu</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
        <a class="order" href="./user/login">Order Now</a>
    </nav>
    <section class="hero" id="home">
        <div class="copy">
            <div class="eyebrow">
                Fresh tea• Real tea • Better tea
            </div>
            <h1>
                Ice Coffee<br>
                <span>Matcha</span>
            </h1>
            <p>
                The perfect balance of bold coffee and smooth matcha,
                freshly prepared with real milk and premium ingredients.
            </p>
            <a class="btn" href="/user/login">
                Order Now →
            </a>
        </div>
    </section>
    <section class="story" id="about">
        <div class="story-text">
            <small>Why they all love it</small>
            <h2>
                More Than<br>
                Just a Drink
            </h2>
            <p>
                Our Ice Coffee Matcha combines premium matcha,
                freshly brewed coffee, and real milk. It is refreshing,
                energizing, and made for everyday moments.
            </p>
        </div>
    </section>
    <section class="menu" id="menu">

        <h2>Our Menu</h2>
        <p class="menu-intro">
            Explore our featured drinks and find your new favorite.
        </p>
        <div class="products">
            <div class="product">
                <div class="info">
                    <h3>Ice latte</h3>
                    <img src="/image/Iced Latte.png" alt="">
                    <p>
                        Bold coffee meets smooth matcha with fresh milk.
                    </p>
                    <h1>Price 150</h1>
                </div>
            </div>
            
        </div>
    </section>
    <section class="experience">
        <div>
            <small>Coffee Time</small>
            <h2>
                Good Drinks.<br>
                Good Vibes.
            </h2>
            <p>Great coffee and matcha, made for your everyday moments.</p>
            <a class="btn" href="#contact">
                Visit Us →
            </a>
        </div>
    </section>
    <footer id="contact">
        <div>
            © 2026 Coffee Time
        </div>
        <div>   
            Instagram • Facebook • TikTok
        </div>
    </footer>
</body>
</html>